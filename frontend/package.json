{
  "name": "pdfz-ui",
  "private": true,
  "description": "PDFz: interfaccia dell'editor PDF che lavora in locale",
  "author": "agjin",
  "license": "AGPL-3.0-only",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:android": "tsc -b && vite build --mode android --outDir ../mobile/www --emptyOutDir",
    "build:ios": "tsc -b && vite build --mode ios --outDir ../mobile/www --emptyOutDir"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "lucide-react": "^0.460.0",
    "mobile-drag-drop": "^2.3.0-rc.2",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
