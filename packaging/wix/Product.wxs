    </Component>

    <Feature Id="Main" Title="PDFz" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="FileAssociation" />
      <ComponentRef Id="ContextMenu" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Aggiornamento: se c'è già una versione installata si sceglie cosa fare con impostazioni e dati.
         keep     = aggiorna e mantieni tutto (predefinito, anche nelle installazioni silenziose /qn)
         settings = salva solo il file delle impostazioni, elimina il resto, installa la nuova versione
         clean    = installazione pulita (predefinito quando non c'è nessuna versione precedente)
         Da riga di comando: msiexec /i PDFz-x.y.z-x64.msi /qn HDSETUPMODE=settings -->
    <!-- "auto" = decide l'installer; il gruppo di scelte (RadioButtonGroup) vuole comunque un valore iniziale (ICE34) -->
    <Property Id="HDSETUPMODE" Value="auto" Secure="yes" />
    <SetProperty Id="HDSETUPMODE" Action="HdSetupModeKeep" Value="keep" After="FindRelatedProducts" Sequence="both"
                 Condition="WIX_UPGRADE_DETECTED AND HDSETUPMODE = &quot;auto&quot;" />
    <SetProperty Id="HDSETUPMODE" Action="HdSetupModeClean" Value="clean" After="HdSetupModeKeep" Sequence="both"
                 Condition="NOT WIX_UPGRADE_DETECTED AND HDSETUPMODE = &quot;auto&quot;" />

    <UI>
      <Dialog Id="HdUpgradeDlg" Width="370" Height="270" Title="Installazione di [ProductName]">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Trovata una versione già installata" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Verrà sostituita dalla versione $(DisplayVersion)." />
        <!-- le due fasi dell'aggiornamento, mostrate nella stessa finestra di avanzamento -->
        <Control Id="InfoVer" Type="Text" X="20" Y="52" Width="335" Height="40" NoPrefix="yes" ShowCondition="HDOLDVERSION" HideCondition="NOT HDOLDVERSION"
                 Text="Sul PC c'è la versione [HDOLDVERSION]. Premendo Avanti: 1) la versione vecchia viene disinstallata, 2) viene installata la versione $(DisplayVersion). Vedrai l'avanzamento di entrambe le fasi in questa finestra." />
        <Control Id="InfoOld" Type="Text" X="20" Y="52" Width="335" Height="40" NoPrefix="yes" ShowCondition="NOT HDOLDVERSION" HideCondition="HDOLDVERSION"
                 Text="Sul PC c'è una versione precedente. Premendo Avanti: 1) la versione vecchia viene disinstallata, 2) viene installata la versione $(DisplayVersion). Vedrai l'avanzamento di entrambe le fasi in questa finestra." />
        <Control Id="DataTitle" Type="Text" X="20" Y="96" Width="335" Height="12" NoPrefix="yes" Text="Cosa fare con i tuoi dati:" />
        <Control Id="Mode" Type="RadioButtonGroup" X="20" Y="110" Width="335" Height="118" Property="HDSETUPMODE">
          <RadioButtonGroup Property="HDSETUPMODE">
            <RadioButton Value="keep" X="0" Y="0" Width="335" Height="36"
                         Text="&amp;Mantieni tutto (consigliato): preferiti, etichette, tema, impostazioni, lingue scaricate e firme salvate restano come sono." />
            <RadioButton Value="settings" X="0" Y="40" Width="335" Height="36"
                         Text="Mantieni solo &amp;preferiti e impostazioni di base (con una copia di sicurezza); elimina il resto dei dati della versione vecchia." />
            <RadioButton Value="clean" X="0" Y="80" Width="335" Height="36"
                         Text="Installazione &amp;pulita: elimina tutte le impostazioni e i dati della versione vecchia, come su un PC nuovo." />
          </RadioButtonGroup>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="A&amp;vanti">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Annulla">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <!-- testi della finestra di avanzamento per le azioni dell'installer (quelli standard sono in Testi.it-IT.wxl) -->
      <ProgressText Action="HdSetupData" Message="Preparazione dei dati secondo la scelta fatta…" />
      <ProgressText Action="HdSetupDataPerUser" Message="Preparazione dei dati secondo la scelta fatta…" />
      <Dialog Id="HdScopeDlg" Width="370" Height="270" Title="Installazione di [ProductName]">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Per chi vuoi installare il programma?" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Scegli se PDFz deve essere disponibile per tutti o solo per te." />
        <Control Id="Scope" Type="RadioButtonGroup" X="20" Y="60" Width="335" Height="150" Property="HDSCOPE">
          <RadioButtonGroup Property="HDSCOPE">
            <RadioButton Value="machine" X="0" Y="0" Width="335" Height="48"
                         Text="Per &amp;tutti gli utenti di questo PC (consigliato): installato in Programmi, con il collegamento nel menu Start di tutti. Servono i permessi di amministratore." />
            <RadioButton Value="user" X="0" Y="70" Width="335" Height="48"
                         Text="&amp;Solo per me (utente corrente): installato nella cartella del tuo profilo, gli altri utenti non lo vedono. Non servono i permessi di amministratore." />
          </RadioButtonGroup>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="A&amp;vanti">
          <!-- ambito e cartella: la cartella va impostata qui perché le cartelle sono già state calcolate -->
          <Publish Property="MSIINSTALLPERUSER" Value="1" Condition="HDSCOPE = &quot;user&quot;" Order="1" />
          <Publish Property="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\PDFz\" Condition="HDSCOPE = &quot;user&quot;" Order="2" />
          <Publish Property="MSIINSTALLPERUSER" Value="{}" Condition="HDSCOPE = &quot;machine&quot;" Order="3" />
          <Publish Property="INSTALLFOLDER" Value="[ProgramFiles64Folder]PDFz\" Condition="HDSCOPE = &quot;machine&quot;" Order="4" />
          <Publish Event="EndDialog" Value="Return" Order="5" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Annulla">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <!-- ultima schermata: casella "Avvia PDFz" (già spuntata) -->
      <!-- Order="1": prima della chiusura della finestra (EndDialog di WixUI ha Order 999) -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <InstallUISequence>
        <FindRelatedProducts After="HdCtxMachine" />
        <Show Dialog="HdUpgradeDlg" Before="WelcomeEulaDlg" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
        <!-- prima installazione: per chi installare (negli aggiornamenti si resta come prima) -->
        <Show Dialog="HdScopeDlg" Before="HdUpgradeDlg" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      </InstallUISequence>
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />

    <!-- Disinstallazione completa: elimina anche dati, impostazioni, firme salvate e file
         temporanei creati dall'app nei profili di tutti gli utenti. Non avviene durante
         un aggiornamento (UPGRADINGPRODUCTCODE), cosi' le impostazioni restano. -->
    <CustomAction Id="CleanupUserData" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]PDFz.exe&quot; --cleanup-all-users"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- installazione "solo per me": gira come l'utente (tocca solo il suo profilo) -->
    <CustomAction Id="CleanupUserDataPerUser" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]PDFz.exe&quot; --cleanup-all-users"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- avvio dell'app a fine installazione (solo con l'interfaccia; con /qn non parte niente).
         Gira come l'utente che ha installato, non come amministratore. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Avvia PDFz" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- il percorso si conosce solo dopo CostFinalize: va impostato con un'azione, non con un valore fisso (WIX1077) -->
    <!-- Prima si usava WixShellExec con il percorso fissato subito dopo CostFinalize: se la cartella cambiava dopo
         (scelta "per tutti / solo per me") o il percorso non era ancora quello definitivo, l'app non partiva.
         Ora si avvia direttamente l'eseguibile, con il percorso letto al momento del clic su "Fine",
         cartella di lavoro = cartella del programma e senza aspettare che finisca (asyncNoWait). -->
    <CustomAction Id="LaunchApplication" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]PDFz.exe&quot;"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <!-- applica la scelta fatta sopra in tutti i profili utente (dopo la copia dei file nuovi) -->
    <CustomAction Id="HdSetupData" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]PDFz.exe&quot; --setup-data [HDSETUPMODE]"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="HdSetupDataPerUser" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]PDFz.exe&quot; --setup-data [HDSETUPMODE]"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <FindRelatedProducts After="HdCtxMachine" />
      <Custom Action="CleanupUserData" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT MSIINSTALLPERUSER" />
      <Custom Action="CleanupUserDataPerUser" After="CleanupUserData"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND MSIINSTALLPERUSER" />
      <Custom Action="HdSetupData" After="InstallFiles"
              Condition="NOT Installed AND NOT REMOVE AND NOT MSIINSTALLPERUSER AND (HDSETUPMODE = &quot;settings&quot; OR HDSETUPMODE = &quot;clean&quot;)" />
      <Custom Action="HdSetupDataPerUser" After="HdSetupData"
              Condition="NOT Installed AND NOT REMOVE AND MSIINSTALLPERUSER AND (HDSETUPMODE = &quot;settings&quot; OR HDSETUPMODE = &quot;clean&quot;)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
