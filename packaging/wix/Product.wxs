<!--
  Installer MSI di PDFz (WiX Toolset v5).
  Compilato da build-windows.ps1 (Version = numero MSI (100+MAJOR).MINOR.PATCH, DisplayVersion = versione MAJOR.MINOR.PATCH):
    wix build Product.wxs -ext WixToolset.UI.wixext -arch x64 -d Version=1.0.0 -bindpath App=..\..\dist\PDFz -o PDFz.msi

  L'UpgradeCode NON va mai cambiato: permette alle versioni nuove di sostituire le vecchie.
  (PDFz ha UpgradeCode, GUID dei componenti, cartelle e chiavi di registro suoi: si installa accanto ad altri
  programmi senza toccarli.)
-->
<?ifndef DisplayVersion?>
<?define DisplayVersion = $(Version)?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="PDFz"
           Manufacturer="agjin"
           Version="$(Version)"
           UpgradeCode="9e97e063-fb59-42d0-938b-06f48a5082c6"
           Scope="perUserOrMachine"
           Language="1040"
           Codepage="1252"
           InstallerVersion="500">
    <SummaryInformation Description="PDFz - editor PDF che lavora in locale" Manufacturer="agjin" />

    <!-- Aggiornamento in due fasi, nella stessa finestra: prima si disinstalla la versione vecchia (con l'avanzamento),
         poi si installa la nuova. I dati dell'utente restano (la pulizia dei dati non parte durante un aggiornamento). -->
    <MajorUpgrade Schedule="afterInstallValidate" DowngradeErrorMessage="È già installata una versione più recente di [ProductName]." />
    <!-- versione già installata (la scrive ogni versione in Software\agjin\PDFz), mostrata nella schermata
         di aggiornamento; se manca la schermata usa un testo generico -->
    <Property Id="HDOLDVERSION">
      <RegistrySearch Id="HdOldVersionM" Root="HKLM" Key="Software\agjin\PDFz" Name="Version" Type="raw" />
    </Property>
    <Property Id="HDOLDVERSIONU">
      <RegistrySearch Id="HdOldVersionU" Root="HKCU" Key="Software\agjin\PDFz" Name="Version" Type="raw" />
    </Property>
    <SetProperty Id="HDOLDVERSION" Action="HdOldVersionFromUser" Value="[HDOLDVERSIONU]" After="AppSearch" Sequence="ui"
                 Condition="NOT HDOLDVERSION AND HDOLDVERSIONU" />
    <!-- MSZIP a blocchi da 200 MB: la compressione "high" (LZX) usa un solo core e su 360 MB di file
         puo' durare ore; MSZIP finisce in pochi minuti e l'MSI e' solo un po' piu' grande -->
    <!-- installazione più rapida: 1 = niente punto di ripristino di Windows (può richiedere decine di secondi),
         2 = calcolo dello spazio solo sui file (salta i controlli che qui non servono). L'avanzamento resta dettagliato. -->
    <Property Id="MSIFASTINSTALL" Value="3" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" MaximumUncompressedMediaSize="200" />

    <Icon Id="AppIcon" SourceFile="..\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCONTACT" Value="agjin" />

    <!-- WebView2 è incluso in Windows 10/11; se manca l'installazione si interrompe con un messaggio chiaro -->
    <Property Id="WEBVIEW2">
      <RegistrySearch Id="WV2Machine" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
    </Property>
    <Property Id="WEBVIEW2USER">
      <RegistrySearch Id="WV2User" Root="HKCU" Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
    </Property>
    <Launch Condition="Installed OR WEBVIEW2 OR WEBVIEW2USER"
            Message="Serve Microsoft Edge WebView2 Runtime (https://go.microsoft.com/fwlink/p/?LinkId=2124703). Installalo e riprova." />

    <!-- ============================================================ per chi installare
         Pacchetto "a doppio uso" (Microsoft: Single Package Authoring):
           machine = per tutti gli utenti del PC: C:\Program Files, menu Start comune, serve un amministratore (UAC);
           user    = solo per l'utente corrente: %LOCALAPPDATA%\Programs, niente permessi di amministratore.
         Con l'interfaccia lo chiede una schermata; da riga di comando:  msiexec /i ... /qn HDSCOPE=user
         Predefinito "machine" (come le versioni precedenti, anche nelle installazioni silenziose /qn).
         Negli aggiornamenti si resta nell'ambito già installato. -->
    <Property Id="HDSCOPE" Value="auto" Secure="yes" />
    <!-- un'installazione "solo per me" scrive questa chiave in HKCU (HKMU = HKCU nelle installazioni per utente) -->
    <Property Id="HDPREVUSER">
      <RegistrySearch Id="HdPrevUser" Root="HKCU" Key="Software\agjin\PDFz" Name="InstallScope" Type="raw" />
    </Property>
    <SetProperty Id="HDSCOPE" Action="HdScopeUser" Value="user" After="AppSearch" Sequence="both"
                 Condition="HDSCOPE = &quot;auto&quot; AND HDPREVUSER = &quot;user&quot;" />
    <SetProperty Id="HDSCOPE" Action="HdScopeMachine" Value="machine" After="HdScopeUser" Sequence="both"
                 Condition="HDSCOPE &lt;&gt; &quot;user&quot;" />
    <!-- ALLUSERS=2 (doppio uso): MSIINSTALLPERUSER=1 → per utente, vuoto → per tutti -->
    <SetProperty Id="MSIINSTALLPERUSER" Action="HdCtxUser" Value="1" After="HdScopeMachine" Sequence="both"
                 Condition="HDSCOPE = &quot;user&quot;" />
    <SetProperty Id="MSIINSTALLPERUSER" Action="HdCtxMachine" Value="[HDNOVALUE]" After="HdCtxUser" Sequence="both"
                 Condition="HDSCOPE = &quot;machine&quot;" />
    <!-- la ricerca della versione già installata avviene DOPO la scelta dell'ambito (vedi le due sequenze più sotto) -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PDFz" />
    </StandardDirectory>

    <!-- tutti i file prodotti da PyInstaller -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.App)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="93ece6c8-ea36-4ded-aeae-5a1c3346262d">
        <Shortcut Id="AppStartMenu" Name="PDFz" Description="Visualizza e modifica documenti PDF"
                  Target="[INSTALLFOLDER]PDFz.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\agjin\PDFz" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        <!-- per chi è installato: serve agli aggiornamenti per restare nello stesso ambito -->
        <RegistryValue Root="HKMU" Key="Software\agjin\PDFz" Name="InstallScope" Type="string" Value="[HDSCOPE]" />
        <RegistryValue Root="HKMU" Key="Software\agjin\PDFz" Name="Version" Type="string" Value="$(DisplayVersion)" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition="DESKTOPSHORTCUT = 1" Guid="cc6310d9-9157-4ba7-b26a-1b9194fe1e55">
        <Shortcut Id="AppDesktop" Name="PDFz" Target="[INSTALLFOLDER]PDFz.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\agjin\PDFz" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Property Id="DESKTOPSHORTCUT" Value="1" />

    <!-- associazione ai .pdf: compare in "Apri con" e in Impostazioni > App predefinite -->
    <Component Id="FileAssociation" Directory="INSTALLFOLDER" Guid="9154bfc9-850d-4a6c-8248-97853e4c9a91">
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Document" Value="Documento PDF" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Document" Name="FriendlyTypeName" Value="Documento PDF (PDFz)" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Document\DefaultIcon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Document\shell\open" Name="FriendlyAppName" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Document\shell\open\command" Value="&quot;[INSTALLFOLDER]PDFz.exe&quot; &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.pdf\OpenWithProgids" Name="PDFz.Document" Value="" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\Applications\PDFz.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\PDFz.exe" Value="[INSTALLFOLDER]PDFz.exe" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\agjin\PDFz\Capabilities" Name="ApplicationName" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\agjin\PDFz\Capabilities" Name="ApplicationDescription" Value="Editor PDF che lavora in locale" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\agjin\PDFz\Capabilities\FileAssociations" Name=".pdf" Value="PDFz.Document" Type="string" />
      <!-- file firmati CAdES (.p7m/.p7s): compaiono in "Apri con" senza togliere l'app predefinita (es. ArubaSign) -->
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Firmato" Value="File firmato digitalmente" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Firmato" Name="FriendlyTypeName" Value="File firmato digitalmente (PDFz)" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Firmato\DefaultIcon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Firmato\shell\open" Name="FriendlyAppName" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.Firmato\shell\open\command" Value="&quot;[INSTALLFOLDER]PDFz.exe&quot; &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.p7m\OpenWithProgids" Name="PDFz.Firmato" Value="" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.p7s\OpenWithProgids" Name="PDFz.Firmato" Value="" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\Applications\PDFz.exe\SupportedTypes" Name=".p7m" Value="" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\agjin\PDFz\Capabilities\FileAssociations" Name=".p7m" Value="PDFz.Firmato" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\agjin\PDFz\Capabilities\FileAssociations" Name=".p7s" Value="PDFz.Firmato" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="PDFz" Value="Software\agjin\PDFz\Capabilities" Type="string" />
    </Component>

    <!-- ============================================================ menu del tasto destro di Esplora risorse
         Voce "PDFz" con un sottomenu, secondo il tipo di file:
           foto ............ Crea PDF · Modifica con PDFz
           documenti ....... Crea PDF (anche selezionando più file: diventano un unico PDF)
           file firmati .... Estrai documento · Verifica firma · Marca temporale · Cifra…
         Il sottomenu è definito una volta (PDFz.Menu*) e collegato a ogni estensione con ExtendedSubCommandsKey.
         MultiSelectModel=Player: la voce compare anche con più di 15 file selezionati.
         Windows 11: le voci classiche sono in "Mostra altre opzioni" (o Maiusc+F10).
         HKMU = HKLM per tutti gli utenti, HKCU per "solo per me". Per non installarlo:  msiexec ... HDCONTEXTMENU=0 -->
    <Property Id="HDCONTEXTMENU" Value="1" Secure="yes" />
    <Component Id="ContextMenu" Directory="INSTALLFOLDER" Guid="63a807cd-ce9c-4ff6-a66e-f81f0ca95434" Condition="HDCONTEXTMENU = 1">
      <RegistryValue Root="HKMU" Key="Software\agjin\PDFz" Name="ContextMenu" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuImmagine\shell\1crea" Name="MUIVerb" Value="Crea PDF" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuImmagine\shell\1crea" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuImmagine\shell\1crea\command" Value="&quot;[INSTALLFOLDER]PDFz.exe&quot; --azione crea-pdf &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuImmagine\shell\2modifica" Name="MUIVerb" Value="Modifica con PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuImmagine\shell\2modifica" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuImmagine\shell\2modifica\command" Value="&quot;[INSTALLFOLDER]PDFz.exe&quot; --azione apri &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuDocumento\shell\1crea" Name="MUIVerb" Value="Crea PDF" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuDocumento\shell\1crea" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuDocumento\shell\1crea\command" Value="&quot;[INSTALLFOLDER]PDFz.exe&quot; --azione crea-pdf &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\1estrai" Name="MUIVerb" Value="Estrai documento" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\1estrai" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\1estrai\command" Value="&quot;[INSTALLFOLDER]PDFz.exe&quot; --azione p7m-estrai &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\2verifica" Name="MUIVerb" Value="Verifica firma" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\2verifica" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\2verifica\command" Value="&quot;[INSTALLFOLDER]PDFz.exe&quot; --azione p7m-verifica &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\3marca" Name="MUIVerb" Value="Marca temporale" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\3marca" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\3marca\command" Value="&quot;[INSTALLFOLDER]PDFz.exe&quot; --azione p7m-marca &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\4cifra" Name="MUIVerb" Value="Cifra…" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\4cifra" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\PDFz.MenuFirmato\shell\4cifra\command" Value="&quot;[INSTALLFOLDER]PDFz.exe&quot; --azione p7m-cifra &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuImmagine" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.png\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuImmagine" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuImmagine" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuImmagine" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuImmagine" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.gif\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuImmagine" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tif\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuImmagine" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.webp\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.webp\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.webp\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuImmagine" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.webp\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuDocumento" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.doc\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.doc\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.doc\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuDocumento" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.doc\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.docx\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.docx\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.docx\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuDocumento" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.docx\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.rtf\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.rtf\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.rtf\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuDocumento" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.rtf\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.odt\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.odt\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.odt\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuDocumento" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.odt\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.xls\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.xls\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.xls\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuDocumento" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.xls\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.xlsx\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.xlsx\shell\PDFz" Name="Icon" Value="[INSTALLFOLDER]PDFz.exe,0" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.xlsx\shell\PDFz" Name="ExtendedSubCommandsKey" Value="PDFz.MenuDocumento" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.xlsx\shell\PDFz" Name="MultiSelectModel" Value="Player" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Classes\SystemFileAssociations\.ods\shell\PDFz" Name="MUIVerb" Value="PDFz" Type="string" />
