<!--
  Pacchetto lingue di PDFz (WiX Toolset v5): i modelli di traduzione in un MSI separato,
  da installare solo sui PC che traducono. L'app lo trova da sola (chiave di registro qui sotto).
  Un MSI per ogni gruppo di lingue (un solo MSI non puo' superare 2 GB). Compilato da build-windows.ps1:
    wix build Lingue.wxs -ext WixToolset.UI.wixext -arch x64 -d Version=1.3.2 -d GroupId=it-fr-de-es
              -d GroupName="Italiano, Francese, Tedesco, Spagnolo" -d UpgradeCode={...} -bindpath Lingue=<cartella> -o ...

  L'UpgradeCode di ogni gruppo lo calcola lo script dal nome del gruppo (MD5 di "PDFz-Lingue-<gruppo>"):
  NON cambiarlo, serve agli aggiornamenti.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="PDFz - Lingue ($(GroupName))"
           Manufacturer="agjin"
           Version="$(Version)"
           UpgradeCode="$(UpgradeCode)"
           Scope="perMachine"
           Language="1040"
           Codepage="1252"
           InstallerVersion="500">
    <SummaryInformation Description="Modelli di traduzione offline per PDFz: $(GroupName)" Manufacturer="agjin" />
    <MajorUpgrade DowngradeErrorMessage="È già installata una versione più recente di [ProductName]." />
    <!-- I modelli (model.bin) sono gia' quasi incomprimibili: la compressione "high" (LZX) su centinaia di MB
         puo' durare ore guadagnando pochissimo. MSZIP e' molto piu' veloce; CAB da 200 MB = compressione in parallelo. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" MaximumUncompressedMediaSize="200" />

    <Icon Id="AppIcon" SourceFile="..\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCONTACT" Value="agjin" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="LANGROOT" Name="PDFz Lingue">
        <Directory Id="INSTALLFOLDER" Name="$(GroupId)" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="LangFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Lingue)\**" />
    </ComponentGroup>
    <Component Id="LangRegistry" Directory="INSTALLFOLDER" Guid="59dbea66-4a79-4825-94c9-585d28394ff4">
      <RegistryValue Root="HKLM" Key="Software\agjin\PDFz Lingue\$(GroupId)" Name="Path" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\agjin\PDFz Lingue\$(GroupId)" Name="Version" Value="$(Version)" Type="string" />
    </Component>

    <Feature Id="Main" Title="Pacchetti lingua" Level="1">
      <ComponentGroupRef Id="LangFiles" />
      <ComponentRef Id="LangRegistry" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
  </Package>
</Wix>
